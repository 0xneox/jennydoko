---
// Point this at a GitHub Release / store URL when the game ships.
const APK_URL = '/jennydoko.apk';
const APK_SIZE = '~90 MB';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JennyDoko — Cozy Puppy Logic Puzzles</title>
  <meta name="description" content="Help Jenny the puppy sitter find every pup's sunny spot. A cozy Star Battle-style logic puzzle with 1000 gardens, daily walks, and zero timers." />
  <meta property="og:title" content="JennyDoko — Cozy Puppy Logic Puzzles" />
  <meta property="og:description" content="Help Jenny find every puppy's sunny spot. 1000 handcrafted logic gardens, daily puzzles, zero stress." />
  <meta property="og:image" content="/assets/icon.png" />
  <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body>

  <nav class="nav">
    <a class="brand" href="#top">
      <img src="/assets/jenny-avatar.jpg" alt="Jenny" class="brand-avatar" />
      <span>JennyDoko</span>
    </a>
    <a class="btn btn-small" href={APK_URL} download>Download APK</a>
  </nav>

  <header class="hero" id="top">
    <img class="paw paw-1" src="/assets/paw.png" alt="" aria-hidden="true" />
    <img class="paw paw-2" src="/assets/paw-2.png" alt="" aria-hidden="true" />
    <img class="paw paw-3" src="/assets/paw-red.png" alt="" aria-hidden="true" />

    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">🐾 Welcome to Greenbark Meadow</p>
        <h1>A cozy logic puzzle<br />with <span class="accent">sleepy puppies</span></h1>
        <p class="lede">
          Jenny is a puppy sitter, and the pups love hiding in their favorite
          flower beds. Use pure deduction to give every puppy its own sunny
          spot — no timers, no pressure, just you and 1000 handcrafted gardens.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={APK_URL} download>
            <span class="btn-icon">⬇</span> Download for Android
          </a>
          <a class="btn btn-ghost" href="#how-to-play">How to play</a>
        </div>
        <p class="apk-note">Free preview APK · Android · {APK_SIZE}</p>
      </div>
      <div class="hero-art">
        <img src="/assets/jenny.png" alt="Jenny the puppy" class="jenny" />
        <img src="/assets/icon.png" alt="JennyDoko app icon" class="hero-icon" />
      </div>
    </div>
  </header>

  <section class="section" id="how-to-play">
    <h2>How to play</h2>
    <p class="section-sub">Three gentle rules. Pure deduction. That's the whole game.</p>
    <div class="rules">
      <div class="rule-card">
        <div class="rule-num">1</div>
        <h3>One pup per patch</h3>
        <p>Every colored flower patch is a cozy territory — each region needs exactly one resting puppy.</p>
      </div>
      <div class="rule-card">
        <div class="rule-num">2</div>
        <h3>Puppies need space</h3>
        <p>No two puppies can touch each other — not even diagonally. They love their naps undisturbed!</p>
      </div>
      <div class="rule-card">
        <div class="rule-num">3</div>
        <h3>Fill every line</h3>
        <p>Each row and column only has room for one puppy. Mark empty beds with chalk to narrow it down.</p>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="features">
    <h2>Why you'll love it</h2>
    <div class="features">
      <div class="feature">
        <span class="feature-emoji">🌼</span>
        <h3>1000 gardens</h3>
        <p>From gentle 4×4 meadows to sprawling expert boards — every puzzle is solvable by pure deduction.</p>
      </div>
      <div class="feature">
        <span class="feature-emoji">🐕🐕</span>
        <h3>Twin boards</h3>
        <p>Past level 600 the gardens get busier: two puppies per row, column, and patch.</p>
      </div>
      <div class="feature">
        <span class="feature-emoji">📅</span>
        <h3>Daily garden walk</h3>
        <p>A fresh puzzle every day. Keep your streak alive and share spoiler-free results with friends.</p>
      </div>
      <div class="feature">
        <span class="feature-emoji">💡</span>
        <h3>Kind hints</h3>
        <p>Jenny's progressive hint system gently nudges you toward the next deduction — never spoils the solve.</p>
      </div>
      <div class="feature">
        <span class="feature-emoji">📖</span>
        <h3>A story to explore</h3>
        <p>Follow Jenny across Greenbark Meadow, the flower beds, and beyond with illustrated story chapters.</p>
      </div>
      <div class="feature">
        <span class="feature-emoji">✈️</span>
        <h3>100% offline</h3>
        <p>No Wi-Fi, no accounts, no ads in your face. Play on the subway, on a flight, or curled up in bed.</p>
      </div>
    </div>
  </section>

  <section class="section" id="story">
    <h2>The story so far</h2>
    <p class="section-sub">Jenny is a puppy sitter at Greenbark Meadow — and the pups keep her busy.</p>
    <div class="story-strip">
      <figure class="story-card">
        <img src="/assets/story-1.jpg" alt="Welcome to Greenbark Meadow" loading="lazy" />
        <figcaption><strong>Part 1 · Greenbark Meadow</strong><br />Sofie brings Jenny to the meadow, where so many amazing friends are waiting.</figcaption>
      </figure>
      <figure class="story-card">
        <img src="/assets/story-2.jpg" alt="The flower beds" loading="lazy" />
        <figcaption><strong>Part 2 · The Flower Beds</strong><br />The pups love hiding in the daisies, bluebells, lavender, and poppies.</figcaption>
      </figure>
      <figure class="story-card">
        <img src="/assets/story-3.jpg" alt="The quest begins" loading="lazy" />
        <figcaption><strong>Part 3 · The Quest</strong><br />Can you help Jenny make sure every puppy gets their own sunny spot?</figcaption>
      </figure>
    </div>
  </section>

  <section class="cta-banner">
    <img src="/assets/icon.png" alt="JennyDoko app icon" class="cta-icon" />
    <div>
      <h2>Ready to meet the pups?</h2>
      <p>Free Android preview — no account, no ads, all 1000 gardens.</p>
    </div>
    <a class="btn btn-primary btn-large" href={APK_URL} download>Download APK</a>
  </section>

  <footer class="footer">
    <div class="footer-inner">
      <span>© 2026 the JennyDoko team</span>
      <div class="footer-links">
        <a href="/privacy.html">Privacy</a>
        <a href="/terms.html">Terms</a>
      </div>
    </div>
  </footer>

</body>
</html>

<style is:global>
  :root {
    --cream: #FBF9F5;
    --ink: #3D2B1F;
    --pink: #FF4D8D;
    --pink-soft: #FFD9E8;
    --green: #27AE60;
    --green-soft: #E4F5EC;
    --gold: #FFC93C;
    --sky: #13B0FA;
    --night: #1F1240;
    --muted: #8A7361;
    --radius: 20px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    background: var(--cream);
    color: var(--ink);
    line-height: 1.6;
  }

  img { max-width: 100%; display: block; }

  /* ---------- nav ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 24px;
    background: rgba(251, 249, 245, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #EFE6DA;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--pink);
  }

  /* ---------- buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn:hover { transform: translateY(-2px); }

  .btn-primary {
    background: var(--pink);
    color: #fff;
    box-shadow: 0 6px 20px rgba(255, 77, 141, 0.35);
  }

  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border: 2px solid #E3D7C9;
  }

  .btn-small {
    padding: 9px 20px;
    font-size: 0.9rem;
    background: var(--pink);
    color: #fff;
  }

  .btn-large { font-size: 1.1rem; padding: 16px 36px; }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #BEE9FF 0%, #E8F7E9 55%, var(--cream) 100%);
    padding: 72px 24px 96px;
  }

  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 48px;
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    font-weight: 700;
    color: var(--green);
    margin-bottom: 12px;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .accent { color: var(--pink); }

  .lede {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 480px;
    margin-bottom: 32px;
  }

  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }

  .apk-note { margin-top: 14px; font-size: 0.85rem; color: var(--muted); }

  .hero-art { position: relative; display: flex; justify-content: center; }

  .jenny {
    width: min(380px, 90%);
    filter: drop-shadow(0 24px 32px rgba(61, 43, 31, 0.25));
    animation: float 5s ease-in-out infinite;
  }

  .hero-icon {
    position: absolute;
    bottom: -18px;
    right: 8%;
    width: 96px;
    border-radius: 24px;
    box-shadow: 0 10px 24px rgba(61, 43, 31, 0.3);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-14px) rotate(1deg); }
  }

  .paw {
    position: absolute;
    width: 72px;
    opacity: 0.25;
  }

  .paw-1 { top: 12%; left: 4%; transform: rotate(-18deg); }
  .paw-2 { top: 60%; left: 46%; transform: rotate(12deg); width: 56px; }
  .paw-3 { bottom: 10%; right: 6%; transform: rotate(24deg); }

  /* ---------- sections ---------- */
  .section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 88px 24px;
    text-align: center;
  }

  .section-alt {
    max-width: none;
    background: var(--green-soft);
  }

  .section-alt > * { max-width: 1100px; margin-left: auto; margin-right: auto; }

  .section h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .section-sub { color: var(--muted); margin-bottom: 48px; }

  /* ---------- rules ---------- */
  .rules {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .rule-card {
    background: #fff;
    border-radius: var(--radius);
    padding: 36px 28px;
    text-align: left;
    box-shadow: 0 8px 24px rgba(61, 43, 31, 0.07);
    border: 1px solid #F0E9DF;
  }

  .rule-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--pink);
    color: #fff;
    font-weight: 800;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .rule-card h3 { margin-bottom: 8px; font-size: 1.2rem; }
  .rule-card p { color: var(--muted); font-size: 0.98rem; }

  /* ---------- features ---------- */
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: left;
  }

  .feature {
    background: #fff;
    border-radius: var(--radius);
    padding: 28px;
    border: 1px solid #E4EFE8;
  }

  .feature-emoji { font-size: 1.8rem; }
  .feature h3 { margin: 12px 0 6px; font-size: 1.1rem; }
  .feature p { color: var(--muted); font-size: 0.95rem; }

  /* ---------- story ---------- */
  .story-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: left;
  }

  .story-card {
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(61, 43, 31, 0.08);
    border: 1px solid #F0E9DF;
  }

  .story-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  .story-card figcaption {
    padding: 18px 20px 22px;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .story-card figcaption strong { color: var(--ink); }

  /* ---------- CTA banner ---------- */
  .cta-banner {
    max-width: 1100px;
    margin: 0 auto 88px;
    padding: 48px;
    background: var(--night);
    border-radius: 28px;
    display: flex;
    align-items: center;
    gap: 32px;
    color: #fff;
    margin-left: 24px;
    margin-right: 24px;
  }

  @media (min-width: 1180px) {
    .cta-banner { margin-left: auto; margin-right: auto; }
  }

  .cta-icon { width: 110px; border-radius: 26px; flex-shrink: 0; }
  .cta-banner h2 { margin-bottom: 6px; }
  .cta-banner p { color: #CBB9F0; margin: 0; }
  .cta-banner .btn { margin-left: auto; flex-shrink: 0; }

  /* ---------- footer ---------- */
  .footer {
    border-top: 1px solid #EFE6DA;
    padding: 28px 24px;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-links { display: flex; gap: 20px; }
  .footer-links a { color: var(--muted); text-decoration: none; }
  .footer-links a:hover { color: var(--pink); }

  /* ---------- responsive ---------- */
  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .lede { margin-left: auto; margin-right: auto; }
    .hero-cta { justify-content: center; }
    .hero-art { order: -1; }
    .jenny { width: min(280px, 80%); }
    .rules, .features, .story-strip { grid-template-columns: 1fr; }
    .cta-banner { flex-direction: column; text-align: center; padding: 36px 28px; }
    .cta-banner .btn { margin-left: 0; }
  }
</style>
